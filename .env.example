# --- API Keys (get these from each provider's console) ---

# Google AI Studio (Gemini)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (free tier, no credit card) — free vision models with :free suffix
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Zoho Books ---
# Follow Zoho Books API OAuth2 setup (see docs/zoho_setup.md)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_organization_id

# Optional: Redirection URI for Zoho OAuth (default for self-client)
ZOHO_REDIRECT_URI=https://www.zoho.com/books/

# Optional: Zoho data center the account lives in — com/in/eu/au/cn.
# Must match the region you signed up in (Indian accounts use "in",
# which changes the OAuth + API hosts to *.zoho.in).
ZOHO_DATA_CENTER=in

# Optional: chart-of-accounts name to book expenses under (must exist).
ZOHO_EXPENSE_ACCOUNT=Uncategorized
